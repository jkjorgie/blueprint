// Blueprint data model.
// Analyst-built applications never change this schema: their field definitions
// live in Application.schema (JSON) and their end-user data lives in
// DataRecord.data (JSONB). Run `npm run db:migrate` after editing this file.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  ANALYST
  END_USER
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         Role     @default(END_USER)
  active       Boolean  @default(true)

  // For END_USER accounts: the analyst who created and manages this account.
  // Null for admins and analysts.
  managedById  String?
  managedBy    User?    @relation("ManagedUsers", fields: [managedById], references: [id])
  managedUsers User[]   @relation("ManagedUsers")

  applications Application[]
  memberships  AppMembership[]
  records      DataRecord[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Application {
  id          String  @id @default(cuid())
  ownerId     String
  owner       User    @relation(fields: [ownerId], references: [id])
  name        String
  slug        String
  description String?

  // The analyst's field definitions. Shape is enforced by src/lib/schema/app-schema.ts.
  schema    Json
  published Boolean @default(false)

  // Set when the analyst archives a draft that already has responses. An
  // archived application is read-only: hidden from members, no new responses,
  // and shown in a collapsed section on the analyst's dashboard.
  archivedAt DateTime?

  // Analyst-supplied CSS applied inside the application's own pages only.
  customCss String?

  members AppMembership[]
  records DataRecord[]
  roles   AppRole[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([ownerId, slug])
}

// Grants an end user access to one application. Without a role the member
// can view and create; a role narrows or widens that.
model AppMembership {
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  roleId        String?
  role          AppRole?    @relation(fields: [roleId], references: [id], onDelete: SetNull)
  createdAt     DateTime    @default(now())

  @@id([userId, applicationId])
}

// A named bundle of permissions defined by the analyst for one application,
// for example Editor or Viewer.
model AppRole {
  id            String      @id @default(cuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  name          String
  canView       Boolean     @default(true)
  canCreate     Boolean     @default(true)
  canEdit       Boolean     @default(false)
  canDelete     Boolean     @default(false)
  // Whether the permissions above reach every response in the application or
  // only the ones the member submitted. Members without a role see only their own.
  allResponses  Boolean     @default(false)
  memberships   AppMembership[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([applicationId, name])
}

// One row submitted through a generated form. `data` is keyed by field name.
model DataRecord {
  id            String      @id @default(cuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  data          Json
  createdById   String
  createdBy     User        @relation(fields: [createdById], references: [id])
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([applicationId, createdAt])
}
