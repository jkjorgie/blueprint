# Copy this file to .env and fill in your values. Never commit .env.

# Ask Jay for the real .env. Everyone shares one Supabase database.
# This must be the session pooler (port 5432) with the query string kept as is.
DATABASE_URL="postgresql://postgres.PROJECT:PASSWORD@aws-0-us-east-1.pooler.supabase.com:5432/postgres?uselibpqcompat=true&sslmode=require"

# Signs session tokens. Generate one with: openssl rand -base64 32
AUTH_SECRET="change-me"

# Password given to every seeded account (npm run db:seed).
SEED_PASSWORD="password123"

# ----------------------------------------------------------------------------
# Optional: Supabase integration variables.
# Vercel's Supabase integration injects these automatically. The app does not
# read any of them yet (it only uses DATABASE_URL), so you can leave them out
# locally. Listed here so the names match production if we start using them.
# ----------------------------------------------------------------------------
SUPABASE_URL="https://PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="sb_anon_xxxxxxxxxxxxxxxxxxxxxxxx"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx"
SUPABASE_SECRET_KEY="sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx"
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiJ9.SERVICE_ROLE.xxxxxxxxxxxxxxxxxxxxxxxx"
SUPABASE_JWT_SECRET="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
POSTGRES_HOST="db.PROJECT.supabase.co"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="PASSWORD"
POSTGRES_DATABASE="postgres"
POSTGRES_URL="postgres://postgres.PROJECT:PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require"
POSTGRES_PRISMA_URL="postgres://postgres.PROJECT:PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require&pgbouncer=true"
POSTGRES_URL_NON_POOLING="postgres://postgres.PROJECT:PASSWORD@aws-0-us-east-1.pooler.supabase.com:5432/postgres?sslmode=require"
