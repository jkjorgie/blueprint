# Copy this file to .env and fill in your values. Never commit .env.

# Your personal Neon branch. In the Neon console open your branch, click
# "Connect", and copy the connection string. Use the direct (non-pooled)
# endpoint so migrations work.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require"

# Signs session tokens. Generate one with: openssl rand -base64 32
AUTH_SECRET="change-me"

# Password given to every seeded account (npm run db:seed).
SEED_PASSWORD="password123"
